# syntax=docker/dockerfile:1.7
#
# Shared image definition for every Go service. The build context is core/, so
# the Go workspace, shared/ and the service's own module are all visible:
#
#   docker build -f deploy/Dockerfile.service --build-arg SERVICE=auth \
#     --target runtime -t axon/auth core/
#
# Targets:
#   dev     — hot reload via air; source is bind-mounted by compose
#   runtime — static binary on a distroless base, runs as nonroot

# Must not fall behind the toolchain in core/go.work, or `go mod download` fails
# with "go.mod requires go >= ...". Bump both together.
ARG GO_VERSION=1.26

# Pinned, not @latest. A floating version means a build that worked yesterday
# can fail today because an upstream release started requiring a newer
# toolchain — which is exactly how this line first broke.
ARG AIR_VERSION=v1.67.3

# ---------------------------------------------------------------------------
# base — dependency resolution, shared by the dev and build stages
# ---------------------------------------------------------------------------
FROM golang:${GO_VERSION}-alpine AS base

ARG SERVICE
WORKDIR /src

RUN apk add --no-cache git

# Manifests are copied before the source so a code change does not invalidate
# the dependency layer.
COPY go.work go.work.sum* ./
COPY shared/go.mod shared/go.sum ./shared/
COPY services/${SERVICE}/go.mod services/${SERVICE}/go.sum* ./services/${SERVICE}/

RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download all

# ---------------------------------------------------------------------------
# dev — hot reload
# ---------------------------------------------------------------------------
FROM base AS dev

ARG SERVICE
ARG AIR_VERSION
ENV SERVICE=${SERVICE}

RUN --mount=type=cache,target=/go/pkg/mod \
    go install github.com/air-verse/air@${AIR_VERSION}

COPY shared/ ./shared/
COPY services/${SERVICE}/ ./services/${SERVICE}/

WORKDIR /src/services/${SERVICE}

# air rebuilds on change; compose bind-mounts the source over this layer. Each
# service ships its own .air.toml next to its go.mod.
CMD ["air", "-c", ".air.toml"]

# ---------------------------------------------------------------------------
# build — static binary
# ---------------------------------------------------------------------------
FROM base AS build

ARG SERVICE
ARG VERSION=dev

COPY shared/ ./shared/
COPY services/${SERVICE}/ ./services/${SERVICE}/

# CGO is off so the result is a static binary that needs no libc in the runtime
# image. Symbol tables are stripped; version is stamped in for /metrics.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/service \
      ./services/${SERVICE}/cmd/${SERVICE}

# ---------------------------------------------------------------------------
# runtime — what actually ships
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

COPY --from=build /out/service /service

# Distroless has no shell, so healthchecks are the orchestrator's job via the
# service's own /healthz endpoint rather than a HEALTHCHECK instruction here.
USER nonroot:nonroot

ENTRYPOINT ["/service"]
