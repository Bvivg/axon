# syntax=docker/dockerfile:1.7
ARG GO_VERSION=1.26

ARG AIR_VERSION=v1.67.3

ARG RUNTIME_FLAVOR=static

FROM golang:${GO_VERSION}-alpine AS base

ARG SERVICE
WORKDIR /src

RUN apk add --no-cache git

ENV GOWORK=off

COPY shared/go.mod shared/go.sum ./shared/
COPY services/${SERVICE}/go.mod services/${SERVICE}/go.sum* ./services/${SERVICE}/

WORKDIR /src/services/${SERVICE}

RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download all

FROM base AS dev

ARG SERVICE
ARG AIR_VERSION
ARG RUNTIME_FLAVOR
ENV SERVICE=${SERVICE}

RUN if [ "$RUNTIME_FLAVOR" = "media" ]; then apk add --no-cache ffmpeg; fi

RUN --mount=type=cache,target=/go/pkg/mod \
    go install github.com/air-verse/air@${AIR_VERSION}

COPY shared/ /src/shared/
COPY services/${SERVICE}/ /src/services/${SERVICE}/

CMD ["air", "-c", ".air.toml"]

FROM base AS build

ARG SERVICE
ARG VERSION=dev

COPY shared/ /src/shared/
COPY services/${SERVICE}/ /src/services/${SERVICE}/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/service \
      ./cmd/${SERVICE}

FROM gcr.io/distroless/static-debian12:nonroot AS runtime-static

COPY --from=build /out/service /service

USER nonroot:nonroot

ENTRYPOINT ["/service"]

FROM alpine:3.24 AS runtime-media

RUN apk add --no-cache ffmpeg ca-certificates \
    && adduser -D -H -u 65532 nonroot

COPY --from=build /out/service /service

USER 65532:65532

ENTRYPOINT ["/service"]

FROM runtime-${RUNTIME_FLAVOR} AS runtime
