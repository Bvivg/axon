ARG STRIMZI_VERSION=1.3.1
ARG KAFKA_VERSION=4.3.2
ARG DEBEZIUM_VERSION=3.7.0.Final

FROM quay.io/debezium/connect:${DEBEZIUM_VERSION} AS debezium

FROM quay.io/strimzi/kafka:${STRIMZI_VERSION}-kafka-${KAFKA_VERSION}

USER root:root

COPY --from=debezium /kafka/connect/debezium-connector-postgres /opt/kafka/plugins/debezium-connector-postgres

USER 1001
