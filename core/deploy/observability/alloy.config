discovery.docker "axon" {
	host = "unix:///var/run/docker.sock"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=axon"]
	}
}

discovery.relabel "axon_logs" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "axon" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.axon.targets
	relabel_rules = discovery.relabel.axon_logs.rules
	forward_to    = [loki.process.axon.receiver]
}

loki.process "axon" {
	stage.json {
		expressions = {
			level          = "",
			service        = "",
			correlation_id = "",
			trace_id       = "",
			span_id        = "",
			msg            = "",
			timestamp      = "",
		}
	}

	stage.template {
		source   = "level"
		template = "{{ ToLower .Value }}"
	}

	stage.labels {
		values = {
			level   = "",
			service = "",
		}
	}

	stage.structured_metadata {
		values = {
			correlation_id = "",
			trace_id       = "",
			span_id        = "",
		}
	}

	stage.timestamp {
		source            = "timestamp"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}

	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

discovery.dns "game" {
	names = ["game"]
	type  = "A"
	port  = 8083
}

discovery.relabel "game_profiles" {
	targets = discovery.dns.game.targets

	rule {
		target_label = "service_name"
		replacement  = "game"
	}
}

pyroscope.scrape "services" {
	targets = [
		{"__address__" = "gateway:9090", "service_name" = "gateway"},
		{"__address__" = "auth:9091", "service_name" = "auth"},
		{"__address__" = "chat:9092", "service_name" = "chat"},
	]
	forward_to = [pyroscope.write.default.receiver]
}

pyroscope.scrape "game" {
	targets    = discovery.relabel.game_profiles.output
	forward_to = [pyroscope.write.default.receiver]
}

pyroscope.write "default" {
	endpoint {
		url = "http://pyroscope:4040"
	}
}
