FROM node:22-bookworm-slim

WORKDIR /app
ENV CI=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY ui/web/package.json ui/web/package-lock.json ./
RUN npm ci
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libnss3-tools openssl iptables \
    && npx playwright install --with-deps chromium firefox \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update \
    && apt-get install -y --no-install-recommends pulseaudio pulseaudio-utils \
    && rm -rf /var/lib/apt/lists/*
