{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "${env:CDC_DATABASE_HOST}",
  "database.port": "${env:CDC_DATABASE_PORT}",
  "database.dbname": "${env:CDC_DATABASE_NAME}",
  "database.user": "debezium",
  "database.password": "${env:DEBEZIUM_DB_PASSWORD}",
  "topic.prefix": "axon",
  "plugin.name": "pgoutput",
  "slot.name": "axon_outbox",
  "publication.name": "axon_outbox",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "auth.outbox,chat.outbox,game.outbox,rating.outbox,tournament.outbox",
  "snapshot.mode": "initial",
  "binary.handling.mode": "bytes",
  "tombstones.on.delete": "false",
  "extended.headers.enabled": "false",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "SELECT pg_logical_emit_message(false, 'axon.heartbeat', now()::text)",
  "message.prefix.exclude.list": "axon.heartbeat",
  "topic.creation.default.replication.factor": "-1",
  "topic.creation.default.partitions": "-1",
  "topic.creation.groups": "forever",
  "topic.creation.forever.include": "auth\\.audit\\.v1,game\\.finished\\.v1,rating\\.changed\\.v1,tournament\\.finished\\.v1",
  "topic.creation.forever.replication.factor": "-1",
  "topic.creation.forever.partitions": "-1",
  "topic.creation.forever.retention.ms": "-1",
  "topic.creation.forever.cleanup.policy": "delete",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.debezium.converters.BinaryDataConverter",
  "value.converter.delegate.converter.type": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.delegate.converter.type.schemas.enable": "false",
  "predicates": "fromAuth,fromChat,fromGame,fromRating,fromTournament",
  "predicates.fromAuth.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.fromAuth.pattern": "axon\\.auth\\.outbox",
  "predicates.fromChat.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.fromChat.pattern": "axon\\.chat\\.outbox",
  "predicates.fromGame.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.fromGame.pattern": "axon\\.game\\.outbox",
  "predicates.fromRating.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.fromRating.pattern": "axon\\.rating\\.outbox",
  "predicates.fromTournament.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.fromTournament.pattern": "axon\\.tournament\\.outbox",
  "transforms": "authOutbox,chatOutbox,gameOutbox,ratingOutbox,tournamentOutbox,allowed,rejected",
  "transforms.authOutbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.authOutbox.predicate": "fromAuth",
  "transforms.authOutbox.route.by.field": "aggregatetype",
  "transforms.authOutbox.route.topic.regex": "(?s)(?<routedByValue>.*)",
  "transforms.authOutbox.route.topic.replacement": "outbox-auth.${routedByValue}",
  "transforms.authOutbox.table.field.event.id": "id",
  "transforms.authOutbox.table.field.event.key": "aggregateid",
  "transforms.authOutbox.table.field.event.payload": "payload",
  "transforms.authOutbox.table.fields.additional.placement": "type:header:event_type,id:header:event_id",
  "transforms.chatOutbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.chatOutbox.predicate": "fromChat",
  "transforms.chatOutbox.route.by.field": "aggregatetype",
  "transforms.chatOutbox.route.topic.regex": "(?s)(?<routedByValue>.*)",
  "transforms.chatOutbox.route.topic.replacement": "outbox-chat.${routedByValue}",
  "transforms.chatOutbox.table.field.event.id": "id",
  "transforms.chatOutbox.table.field.event.key": "aggregateid",
  "transforms.chatOutbox.table.field.event.payload": "payload",
  "transforms.chatOutbox.table.fields.additional.placement": "type:header:event_type,id:header:event_id",
  "transforms.gameOutbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.gameOutbox.predicate": "fromGame",
  "transforms.gameOutbox.route.by.field": "aggregatetype",
  "transforms.gameOutbox.route.topic.regex": "(?s)(?<routedByValue>.*)",
  "transforms.gameOutbox.route.topic.replacement": "outbox-game.${routedByValue}",
  "transforms.gameOutbox.table.field.event.id": "id",
  "transforms.gameOutbox.table.field.event.key": "aggregateid",
  "transforms.gameOutbox.table.field.event.payload": "payload",
  "transforms.gameOutbox.table.fields.additional.placement": "type:header:event_type,id:header:event_id",
  "transforms.ratingOutbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.ratingOutbox.predicate": "fromRating",
  "transforms.ratingOutbox.route.by.field": "aggregatetype",
  "transforms.ratingOutbox.route.topic.regex": "(?s)(?<routedByValue>.*)",
  "transforms.ratingOutbox.route.topic.replacement": "outbox-rating.${routedByValue}",
  "transforms.ratingOutbox.table.field.event.id": "id",
  "transforms.ratingOutbox.table.field.event.key": "aggregateid",
  "transforms.ratingOutbox.table.field.event.payload": "payload",
  "transforms.ratingOutbox.table.fields.additional.placement": "type:header:event_type,id:header:event_id",
  "transforms.tournamentOutbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.tournamentOutbox.predicate": "fromTournament",
  "transforms.tournamentOutbox.route.by.field": "aggregatetype",
  "transforms.tournamentOutbox.route.topic.regex": "(?s)(?<routedByValue>.*)",
  "transforms.tournamentOutbox.route.topic.replacement": "outbox-tournament.${routedByValue}",
  "transforms.tournamentOutbox.table.field.event.id": "id",
  "transforms.tournamentOutbox.table.field.event.key": "aggregateid",
  "transforms.tournamentOutbox.table.field.event.payload": "payload",
  "transforms.tournamentOutbox.table.fields.additional.placement": "type:header:event_type,id:header:event_id",
  "transforms.allowed.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.allowed.regex": "outbox-(?:auth\\.(?=auth\\.(?:audit|user\\.registered)\\.v1$)|chat\\.(?=(?:chat\\.message|call\\.ended)\\.v1$)|game\\.(?=game\\.finished\\.v1$)|rating\\.(?=rating\\.changed\\.v1$)|tournament\\.(?=tournament\\.(?:round_started|forfeit|cancelled|finished)\\.v1$))(.+)",
  "transforms.allowed.replacement": "$1",
  "transforms.rejected.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.rejected.regex": "(?s)outbox-.*|axon\\.[a-z_]+\\.outbox",
  "transforms.rejected.replacement": "cdc.rejected.v1"
}
