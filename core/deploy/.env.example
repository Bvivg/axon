# Copy to core/deploy/.env and adjust. The real .env is git-ignored and must
# never be committed.
#
#   cp core/deploy/.env.example core/deploy/.env

# ---------------------------------------------------------------------------
# Host port mapping
# ---------------------------------------------------------------------------
# Only affects access from the host. Change these if the defaults collide with
# something already running on your machine.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
AUTH_HOST_PORT=8081
AUTH_METRICS_HOST_PORT=9091
GATEWAY_HOST_PORT=18080
GATEWAY_METRICS_HOST_PORT=19090

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=axon
POSTGRES_PASSWORD=axon
POSTGRES_DB=axon

# Superuser DSN. Used by migrations, psql and tooling — not by services, which
# each get their own role below.
POSTGRES_DSN=postgres://axon:axon@postgres:5432/axon?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# One database, one schema per service, one login role per schema. A role holds
# USAGE and CREATE on its own schema and nothing anywhere else, so a
# cross-schema JOIN fails at the database rather than at review time.
#
# The roles are created by core/deploy/postgres/init/, which runs once when the
# data volume is first created. After changing a password here, run `make reset`
# to replay the init scripts — an existing volume will not pick it up.
AUTH_DB_PASSWORD=auth
CHAT_DB_PASSWORD=chat
GAME_DB_PASSWORD=game
CALLING_DB_PASSWORD=calling

# Services connect over the compose network, so the host is the service name and
# the port is the container's, not the mapped one above. Each service gets the
# DSN of its own role; the superuser DSN is for migrations and psql only.
AUTH_POSTGRES_DSN=postgres://auth_service:auth@postgres:5432/axon?sslmode=disable&search_path=auth
CHAT_POSTGRES_DSN=postgres://chat_service:chat@postgres:5432/axon?sslmode=disable&search_path=chat
GAME_POSTGRES_DSN=postgres://game_service:game@postgres:5432/axon?sslmode=disable&search_path=game
CALLING_POSTGRES_DSN=postgres://calling_service:calling@postgres:5432/axon?sslmode=disable&search_path=calling

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# The password is not optional even locally: the port is published on the host.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=axon
REDIS_DB=0

# ---------------------------------------------------------------------------
# Common service settings
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Auth — JWT
# ---------------------------------------------------------------------------
# RS256 signing keys, PEM-encoded. Generate a development pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
# The key ID is published in the JWKS so keys can be rotated without a flag day:
# a new key is added and announced first, and only then used for signing.
JWT_ACTIVE_KEY_ID=dev-1
JWT_PRIVATE_KEY_DEV_1=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
JWT_ISSUER=https://auth.axon.local

# ---------------------------------------------------------------------------
# Auth — OAuth providers
# ---------------------------------------------------------------------------
# Left empty on purpose. Until real credentials are filled in, development and
# e2e runs use the fake provider below, which exercises the full authorization
# code flow without any third party. A provider missing either half of its
# credentials counts as absent, so a partly-filled entry is never half-live.
#
# The fake provider accepts any identity it is handed. The service refuses to
# start with it enabled and APP_ENV=production.
OAUTH_FAKE_ENABLED=true
OAUTH_FAKE_AUTHORIZE_URL=http://localhost:8081/oauth/fake/authorize

# Where a provider returns the browser. The provider name is appended, giving
# .../auth/callback/google. This points at the web client, not at the gateway:
# the client reads the code out of the query and calls CompleteOAuth, so tokens
# never travel through a redirect URL. Each provider's console needs the exact
# URL registered.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000/auth/callback

# Allow-list for where a client may be sent after signing in. An open redirect
# here is how an attacker harvests authorization codes, so it is exact origins.
OAUTH_ALLOWED_RETURN_ORIGINS=http://localhost:3000

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Apple is not implemented yet: its client secret is a short-lived ES256 JWT
# signed with a downloaded .p8 key, its profile arrives only inside the id_token
# and only on first authorization, and its callback is a form POST rather than a
# redirect. Filling these in does nothing until that lands.
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Explicit allow-list. A wildcard origin is never acceptable: the gateway is the
# trust boundary.
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
# Tighter budget for operations that are expensive or attackable by brute force.
RATE_LIMIT_AUTH_PER_MINUTE=10

# The refresh token a browser holds. The gateway moves it out of the response
# body and into an HttpOnly cookie, so page script never touches the long-lived
# half of the pair; other clients keep receiving it in the body.
#
# Secure defaults to on outside APP_ENV=development. Browsers accept Secure
# cookies on http://localhost, so leaving it on is fine there too — it only has
# to come off to reach a dev server over plain HTTP at a LAN address.
REFRESH_COOKIE_SECURE=false
# Must not exceed JWT_REFRESH_TOKEN_TTL above. The gateway cannot read auth's
# configuration, and a longer value here only leaves the browser holding a
# cookie the server already treats as dead.
REFRESH_COOKIE_MAX_AGE=720h

# ---------------------------------------------------------------------------
# Web client
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080
