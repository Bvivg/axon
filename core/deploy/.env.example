# Copy to core/deploy/.env and adjust. The real .env is git-ignored and must
# never be committed.
#
#   cp core/deploy/.env.example core/deploy/.env

# ---------------------------------------------------------------------------
# Host port mapping
# ---------------------------------------------------------------------------
# Only affects access from the host. Change these if the defaults collide with
# something already running on your machine.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
AUTH_HOST_PORT=8081
AUTH_METRICS_HOST_PORT=9091
CHAT_HOST_PORT=8082
CHAT_METRICS_HOST_PORT=9092
KAFKA_HOST_PORT=59092
GATEWAY_HOST_PORT=18080
GATEWAY_METRICS_HOST_PORT=19090
WEB_HOST_PORT=3003
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
CONNECT_HOST_PORT=58083
REGISTRY_HOST_PORT=58081

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=axon
POSTGRES_PASSWORD=axon
POSTGRES_DB=axon

# Superuser DSN. Used by migrations, psql and tooling — not by services, which
# each get their own role below.
POSTGRES_DSN=postgres://axon:axon@postgres:5432/axon?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# One database, one schema per service, one login role per schema. A role holds
# USAGE and CREATE on its own schema and nothing anywhere else, so a
# cross-schema JOIN fails at the database rather than at review time.
#
# The roles are created by core/deploy/postgres/init/, which runs once when the
# data volume is first created. After changing a password here, run `make reset`
# to replay the init scripts — an existing volume will not pick it up.
AUTH_DB_PASSWORD=auth
CHAT_DB_PASSWORD=chat
GAME_DB_PASSWORD=game
CALLING_DB_PASSWORD=calling
RATING_DB_PASSWORD=rating
ANALYSIS_DB_PASSWORD=analysis
TOURNAMENT_DB_PASSWORD=tournament

# Services connect over the compose network, so the host is the service name and
# the port is the container's, not the mapped one above. Each service gets the
# DSN of its own role; the superuser DSN is for migrations and psql only.
AUTH_POSTGRES_DSN=postgres://auth_service:auth@postgres:5432/axon?sslmode=disable&search_path=auth
CHAT_POSTGRES_DSN=postgres://chat_service:chat@postgres:5432/axon?sslmode=disable&search_path=chat
GAME_POSTGRES_DSN=postgres://game_service:game@postgres:5432/axon?sslmode=disable&search_path=game
CALLING_POSTGRES_DSN=postgres://calling_service:calling@postgres:5432/axon?sslmode=disable&search_path=calling
RATING_POSTGRES_DSN=postgres://rating_service:rating@postgres:5432/axon?sslmode=disable&search_path=rating
ANALYSIS_POSTGRES_DSN=postgres://analysis_service:analysis@postgres:5432/axon?sslmode=disable&search_path=analysis
TOURNAMENT_POSTGRES_DSN=postgres://tournament_service:tournament@postgres:5432/axon?sslmode=disable&search_path=tournament

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# The password is not optional even locally: the port is published on the host.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=axon
REDIS_DB=0
EDGE_REDIS_PASSWORD=axon-edge
POSTGRES_REPLICATION_PASSWORD=replicator
POSTGRES_REPLICATION_SLOT=axon_replica
DEBEZIUM_DB_PASSWORD=debezium

# ---------------------------------------------------------------------------
# Common service settings
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=15s
# Largest decoded Connect message any service reads; gzip bodies stop inflating
# here instead of being decompressed in full.
RPC_READ_MAX_BYTES=262144

# ---------------------------------------------------------------------------
# Auth — JWT
# ---------------------------------------------------------------------------
# RS256 signing keys, PEM-encoded. Generate a development pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
# The key ID is published in the JWKS so keys can be rotated without a flag day:
# a new key is added and announced first, and only then used for signing.
JWT_ACTIVE_KEY_ID=dev-1
JWT_PRIVATE_KEY_DEV_1=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
JWT_ISSUER=https://auth.axon.local
JWT_ROTATION_INTERVAL=24h
JWT_ROTATION_LEAD=20m
JWT_KEY_ENCRYPTION_KEY=
ARGON2_MAX_CONCURRENT=4
ARGON2_QUEUE_TIMEOUT=2s
LOGIN_THROTTLE_THRESHOLD=5
LOGIN_THROTTLE_BASE_DELAY=15s
LOGIN_THROTTLE_MAX_DELAY=15m
LOGIN_THROTTLE_WINDOW=1h

# ---------------------------------------------------------------------------
# Auth — OAuth providers
# ---------------------------------------------------------------------------
# Left empty on purpose. Until real credentials are filled in, development and
# e2e runs use the fake provider below, which exercises the full authorization
# code flow without any third party. A provider missing either half of its
# credentials counts as absent, so a partly-filled entry is never half-live.
#
# The fake provider mints any @fake.axon.test identity and never links to an
# existing account. The service refuses to start with it unless APP_ENV=test, or
# APP_ENV=development with loopback redirect and authorize URLs.
OAUTH_FAKE_ENABLED=false
OAUTH_FAKE_AUTHORIZE_URL=http://localhost:8081/oauth/fake/authorize

# Where a provider returns the browser. The provider name is appended, giving
# .../auth/callback/google. This points at the web client, not at the gateway:
# the client reads the code out of the query and calls CompleteOAuth, so tokens
# never travel through a redirect URL. Each provider's console needs the exact
# URL registered.
OAUTH_REDIRECT_BASE_URL=http://localhost:3003/auth/callback

# Allow-list for where a client may be sent after signing in. An open redirect
# here is how an attacker harvests authorization codes, so it is exact origins.
OAUTH_ALLOWED_RETURN_ORIGINS=http://localhost:3003

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Apple takes four values rather than two, because its client secret is signed
# rather than issued: this service mints a short-lived ES256 assertion from the
# team's .p8 key and re-mints it as it expires. All four are required together —
# three of four counts as absent, like any half-filled entry above.
#
#   CLIENT_ID    the Services ID, not the App ID
#   TEAM_ID      the developer team that owns the key
#   KEY_ID       the id of the .p8 key, from the Keys section of the console
#   PRIVATE_KEY  the .p8 file itself: a literal PEM or base64 of one, the same
#                two forms JWT_PRIVATE_KEY_* accepts, because a PEM block is
#                multi-line and .env files disagree about newlines
#
# Apple's callback is a form POST, which a client page cannot receive, so Apple
# alone returns to a server route: the Return URL registered in its console must
# be <web origin>/auth/apple/callback rather than /auth/callback/apple. That
# address is derived from OAUTH_REDIRECT_BASE_URL above, so there is nothing
# further to set here.
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Avatars — MinIO (S3-compatible object storage)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=axon
MINIO_ROOT_PASSWORD=axon12345
AVATARS_ACCESS_KEY=axon-avatars
AVATARS_SECRET_KEY=axon-avatars-dev-secret
ATTACHMENTS_ACCESS_KEY=axon-attachments
ATTACHMENTS_SECRET_KEY=axon-attachments-dev-secret

# The browser loads avatar images directly from MinIO — same pattern as
# LiveKit media bypassing the gateway — so this is the host-mapped port above,
# not the compose-network hostname the auth service itself connects to.
AVATARS_PUBLIC_URL=http://localhost:59000
AVATARS_MAX_PIXELS=25000000
AVATARS_MAX_SIDE=8192
AVATARS_MAX_CONCURRENT=2
AVATARS_QUEUE_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Chat — Web Push
# ---------------------------------------------------------------------------
# VAPID pair, base64url (an uncompressed P-256 point and the raw private scalar).
# Generate with `make vapid-key`. Left empty, push is off and everything else in
# chat works; browsers drop subscriptions made under a key that later changes.
CHAT_VAPID_PUBLIC_KEY=
CHAT_VAPID_PRIVATE_KEY=
CHAT_VAPID_SUBJECT=mailto:push@axon.test
# Pushes one sender may cause on one recipient's devices.
CHAT_PUSH_PER_SENDER_PER_MINUTE=6
CHAT_PUSH_PER_SENDER_BURST=5

# Per chat socket. Sends, edits and deletes share the send budget and are refused
# past it; typing past its budget is dropped; new subscriptions are paced.
CHAT_WS_SEND_PER_MINUTE=300
CHAT_WS_SEND_BURST=20
CHAT_WS_TYPING_PER_MINUTE=120
CHAT_WS_TYPING_BURST=5
CHAT_WS_SUBSCRIBE_PER_MINUTE=600
CHAT_WS_SUBSCRIBE_BURST=500

# ---------------------------------------------------------------------------
# Chat — P2P Calls (disabled until the milestone gate is approved)
# ---------------------------------------------------------------------------
CALLS_ENABLED=false
CALLS_TURN_URLS=
CALLS_TURN_SECRET=
CALLS_MIGRATION_ENABLED=false
CALLS_MIGRATION_DISABLE_NEW=false

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Explicit allow-list. A wildcard origin is never acceptable: the gateway is the
# trust boundary.
CORS_ALLOWED_ORIGINS=http://localhost:3003
RATE_LIMIT_PER_MINUTE=120
# Tighter budget for operations that are expensive or attackable by brute force.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
# WebSocket upgrades per user (per address for failed upgrades) and open sockets
# per user on each endpoint of one gateway instance.
RATE_LIMIT_SOCKETS_PER_MINUTE=60
WS_MAX_CONNECTIONS_PER_USER=16
# Request bodies outside the upload routes, the time to read a request, idle
# keep-alive connections, and the longest list one request may carry.
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=2m
RPC_MAX_LIST_ITEMS=100

# The refresh token a browser holds. The gateway moves it out of the response
# body and into an HttpOnly cookie, so page script never touches the long-lived
# half of the pair; other clients keep receiving it in the body.
#
# Secure defaults to on outside APP_ENV=development. Browsers accept Secure
# cookies on http://localhost, so leaving it on is fine there too — it only has
# to come off to reach a dev server over plain HTTP at a LAN address.
REFRESH_COOKIE_SECURE=false
# Must not exceed JWT_REFRESH_TOKEN_TTL above. The gateway cannot read auth's
# configuration, and a longer value here only leaves the browser holding a
# cookie the server already treats as dead.
REFRESH_COOKIE_MAX_AGE=720h

# ---------------------------------------------------------------------------
# Web client
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ variables are inlined into the browser bundle, so this is the
# address the browser reaches the gateway on — never the compose hostname.
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080

# Which provider buttons to show. The auth service decides which providers
# actually work (one missing half of its credentials counts as absent) and the
# contract has no way to ask, so the two are configured separately: a provider
# listed here but not configured there fails at StartOAuth with a clear message.
NEXT_PUBLIC_OAUTH_PROVIDERS=fake

# Server-side Gateway snapshots. Set the metrics URL to an empty value to
# disable telemetry and keep the route catalog available.
AXON_GATEWAY_METRICS_URL=http://gateway:9090
AXON_GATEWAY_ENVIRONMENT=Local
